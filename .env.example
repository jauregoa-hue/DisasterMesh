# Run scripts/setup.ps1 to generate .env with independent random secrets.
POSTGRES_DB=disastermesh
POSTGRES_USER=disastermesh
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://disastermesh:CHANGE_ME@127.0.0.1:5432/disastermesh
JWT_SECRET=
GATEWAY_API_KEY=
MESHTASTIC_PORT=COM9
MESHTASTIC_ALLOWED_NODES=!0436bda8
GATEWAY_API_URL=http://localhost:8000
GATEWAY_OUTBOX=./gateway-outbox.db
GPS_MAX_AGE_SECONDS=300
AI_MODE=rules
# Optional local tile server/template, bundled tiles, or blank for OSM online tiles.
VITE_MAP_TILE_URL=
